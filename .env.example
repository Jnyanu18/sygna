# Copy to .env and fill in. Never commit .env.

# Sentry (optional — omit to run without Sentry)
# SENTRY_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=1

# Groq (SYGNA diagnose / generate)
# GROQ_API_KEY=

# Supabase (pipeline persistence)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=   # use service_role secret for inserts; anon only if RLS allows
# SYGNA_SUPABASE_TABLE=sygna_fixes1   # optional; default is sygna_fixes1

# Redis (BullMQ — optional; omit = in-process pipeline)
# REDIS_URL=redis://127.0.0.1:6379

# GitHub (auto PR / approve)
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_DEFAULT_BRANCH=main

# Only if repo root != process cwd
# SYGNA_PROJECT_ROOT=
